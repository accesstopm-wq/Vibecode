{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vidaa-tunnel-proxy",
  "main": "index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "TUNNEL",
      "id": "REPLACED_BY_DEPLOY_WORKFLOW"
    }
  ],
  "secrets": {
    "required": ["UPDATE_TOKEN"]
  }
}
